# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGINS=*

# --- Postgres ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance

# --- Auth ---
# In production, generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_me_with_at_least_32_bytes_of_random_data
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
BCRYPT_COST=12
