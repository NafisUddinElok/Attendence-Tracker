@baseUrl = http://localhost:5000

### -------------------------------------------------------------
### 1. Server Health Check
### -------------------------------------------------------------
GET {{baseUrl}}/health

### -------------------------------------------------------------
### 2. Register Teacher (Run once)
### -------------------------------------------------------------
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "role": "TEACHER",
  "fullName": "mahfuzur rahman emon",
  "email": "emon-iict@teacher.sust.edu",
  "password": "password123",
  "code": "SWE-150",
  "department": "SWE",
  "designation": "Associate Professor"
}

### -------------------------------------------------------------
### 3. Login as Teacher
### -------------------------------------------------------------
# @name teacherLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "role": "TEACHER",
  "email": "emon-iict@teacher.sust.edu",
  "password": "password123"
}

### -------------------------------------------------------------
### 4. Teacher: Create / Get Course
### -------------------------------------------------------------
# @name createCourse
POST {{baseUrl}}/api/courses
Content-Type: application/json
Authorization: Bearer {{teacherLogin.response.body.token}}

{
  "courseCode": "SWE-150",
  "title": "Flutter project",
  "department": "SWE"
}

### -------------------------------------------------------------
### 5. Register Student (Run once)
### -------------------------------------------------------------
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "role": "STUDENT",
  "fullName": "Muhammad Nafis Uddin",
  "email": "2023831005@student.sust.edu",
  "password": "password123",
  "code": "2023831061",
  "department": "SWE",
  "session": "2023-24"
}

### -------------------------------------------------------------
### 6. Login as Student
### -------------------------------------------------------------
# @name studentLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "role": "STUDENT",
  "email": "2023831005@student.sust.edu",
  "password": "password123"
}

### -------------------------------------------------------------
### 7. Student: Enroll in Course
### -------------------------------------------------------------
POST {{baseUrl}}/api/courses/enroll
Content-Type: application/json
Authorization: Bearer {{studentLogin.response.body.token}}

{
  "courseId": "{{createCourse.response.body.course.id}}"
}

### -------------------------------------------------------------
### 8. Teacher: Start Attendance Session (Center GPS: SUST)
### -------------------------------------------------------------
# @name startAttendanceSession
POST {{baseUrl}}/api/attendance/session/start
Content-Type: application/json
Authorization: Bearer {{teacherLogin.response.body.token}}

{
  "courseId": "{{createCourse.response.body.course.id}}",
  "title": "Flutter project class 01",
  "centerLat": 24.9172,
  "centerLng": 91.8319,
  "radiusMeters": 50,
  "durationMinutes": 10
}

### -------------------------------------------------------------
### 9. Teacher: View Live Attendees
### -------------------------------------------------------------
GET {{baseUrl}}/api/attendance/session/{{startAttendanceSession.response.body.session.id}}/live
Authorization: Bearer {{teacherLogin.response.body.token}}

### -------------------------------------------------------------
### 10. Student: Submit Attendance (Anti-Proxy Test)
### -------------------------------------------------------------
POST {{baseUrl}}/api/attendance/verify
Content-Type: application/json
Authorization: Bearer {{studentLogin.response.body.token}}

{
  "sessionId": "{{startAttendanceSession.response.body.session.id}}",
  "token": "TEST_INVALID_TOKEN",
  "deviceId": "DEVICE_ANDROID_UUID_99183",
  "lat": 24.91721,
  "lng": 91.83191,
  "isMockLocation": false,
  "livenessPassed": true,
  "faceEmbedding": [0.12, -0.23, 0.45]
}

### -------------------------------------------------------------
### 11. Teacher: Download Full Attendance CSV File
### -------------------------------------------------------------
GET {{baseUrl}}/api/attendance/export-csv/{{createCourse.response.body.course.id}}
Authorization: Bearer {{teacherLogin.response.body.token}}



### -------------------------------------------------------------
### 12. Student: Register Face Biometrics & Lock Device
### -------------------------------------------------------------
# @name registerBiometrics
POST {{baseUrl}}/api/auth/register-biometrics
Content-Type: application/json
Authorization: Bearer {{studentLogin.response.body.token}}

{
  "deviceId": "DEVICE_MAC_TEST_UUID_001",
  "faceEmbedding": [
    0.045, -0.123, 0.789, 0.012, -0.567, 0.234, 0.891, -0.045,
    0.112, 0.456, -0.321, 0.654, -0.098, 0.876, -0.543, 0.210
  ]
}

### -------------------------------------------------------------
### 13. Student: Attempt Registration from DIFFERENT Device (Should FAIL 403)
### -------------------------------------------------------------
POST {{baseUrl}}/api/auth/register-biometrics
Content-Type: application/json
Authorization: Bearer {{studentLogin.response.body.token}}

{
  "deviceId": "DEVICE_HACKER_ATTEMPT_UUID_999",
  "faceEmbedding": [0.045, -0.123, 0.789]
}